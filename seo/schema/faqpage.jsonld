      "acceptedAnswer": { "@type": "Answer", "text": "The Boeing 737-200 cabins are R2,250 per person per night sharing, and the exclusive-use Boeing 727 VIP suite is R3,250 per person per night (minimum 4 guests). Rates include bed and breakfast." }
    },
